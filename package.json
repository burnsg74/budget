{
  "name": "4001-budget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local budget app: Vite + Svelte 5 SPA, node:http API, CSV data",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "NODE_ENV=development node --env-file-if-exists=.env.development --watch backend/main.js",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "NODE_ENV=production node backend/main.js",
    "test": "node --test \"frontend/src/lib/*.test.js\" \"backend/*.test.js\""
  }
}
